# Default: normalize text files to LF in repo and working tree
* text=auto eol=lf

# Source/config files
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf

# PowerShell can also use LF safely in pwsh
*.ps1 text eol=lf

# Windows batch/cmd should use CRLF if added later
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.pdf binary